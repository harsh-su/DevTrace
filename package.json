{
  "name": "devtrace",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "ui",
    "vscode",
    "opencode-plugin",
    "antigravity"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "test": "npm run test:core && npm run test:ui && npm run test:plugin",
    "test:core": "tsx core/test/trace.test.ts && tsx core/test/diff.test.ts && tsx core/test/tour.test.ts && tsx core/test/flow.test.ts && tsx core/test/comments.test.ts",
    "test:ui": "tsx ui/test/SourceView.test.tsx && tsx ui/test/FileTraceView.test.tsx",
    "test:plugin": "tsx opencode-plugin/test/bridge.test.ts",
    "test:antigravity": "tsx antigravity/test/hook.test.ts",
    "build:plugin": "npm --workspace opencode-devtrace run build",
    "package:extension": "npm --workspace devtrace run package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devtrace/core": "*",
    "@devtrace/ui": "*",
    "fastify": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
