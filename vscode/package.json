{
  "name": "aitrace",
  "displayName": "AItrace",
  "description": "Trace code you actually write — AI proposes, you type it. Code-aware typing practice inside the editor.",
  "version": "1.0.5",
  "private": true,
  "publisher": "byteWorxs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:aitrace.pending",
    "onView:aitrace.tour"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aitrace",
          "title": "AItrace",
          "icon": "resources/aitrace.svg"
        }
      ]
    },
    "views": {
      "aitrace": [
        {
          "id": "aitrace.tour",
          "name": "Learning path",
          "icon": "resources/aitrace.svg",
          "contextualTitle": "AItrace"
        },
        {
          "id": "aitrace.pending",
          "name": "Pending changes",
          "icon": "resources/aitrace.svg",
          "contextualTitle": "AItrace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aitrace.tour",
        "contents": "No learning path yet. Ask OpenCode or GitHub Copilot to “tour me through this project” and it will order the codebase into explain-then-type steps.\n[Trace the next step](command:aitrace.tour.next)"
      },
      {
        "view": "aitrace.pending",
        "when": "!aitrace.stagingEnabled",
        "contents": "AItrace is off. Turn it on to stage AI edits for hand-typing over ghost overlays.\n[Turn on AItrace](command:aitrace.enableStaging)\n[Setup GitHub Copilot Integration](command:aitrace.setupCopilot)\n[Setup OpenCode Plugin](command:aitrace.installOpencodePlugin)\n[Setup Google Antigravity Integration](command:aitrace.setupAntigravity)"
      },
      {
        "view": "aitrace.pending",
        "when": "aitrace.stagingEnabled",
        "contents": "No pending changes. When GitHub Copilot, OpenCode, or Google Antigravity proposes an edit, it will wait here for you to type it by hand.\n[Trace a selection](command:aitrace.traceSelection)\n[Setup GitHub Copilot Integration](command:aitrace.setupCopilot)\n[Setup OpenCode Plugin](command:aitrace.installOpencodePlugin)\n[Setup Antigravity Integration](command:aitrace.setupAntigravity)"
      }
    ],
    "commands": [
      {
        "command": "aitrace.openSidebar",
        "title": "AItrace: Open Sidebar (Pending Changes)"
      },
      {
        "command": "aitrace.setupAntigravity",
        "title": "AItrace: Setup Google Antigravity Integration"
      },
      {
        "command": "aitrace.setupCopilot",
        "title": "AItrace: Setup GitHub Copilot Integration"
      },
      {
        "command": "aitrace.traceSelection",
        "title": "AItrace: Trace Selection"
      },
      {
        "command": "aitrace.traceFile",
        "title": "AItrace: Trace File Range"
      },
      {
        "command": "aitrace.endSession",
        "title": "AItrace: End Trace Session"
      },
      {
        "command": "aitrace.showResults",
        "title": "AItrace: Show Last Results"
      },
      {
        "command": "aitrace.installOpencodePlugin",
        "title": "AItrace: Install OpenCode Plugin"
      },
      {
        "command": "aitrace.tour.trace",
        "title": "Trace Step",
        "category": "AItrace",
        "icon": "$(keyboard)"
      },
      {
        "command": "aitrace.tour.next",
        "title": "AItrace: Trace Next Learning Step",
        "category": "AItrace",
        "icon": "$(play)"
      },
      {
        "command": "aitrace.tour.reveal",
        "title": "Reveal Step File",
        "category": "AItrace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aitrace.tour.reset",
        "title": "Clear Learning Path Progress",
        "category": "AItrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "aitrace.tour.refresh",
        "title": "Refresh Learning Path",
        "category": "AItrace",
        "icon": "$(refresh)"
      },
      {
        "command": "aitrace.pending.accept",
        "title": "Accept Change (Write to Disk)",
        "category": "AItrace",
        "icon": "$(check)"
      },
      {
        "command": "aitrace.pending.acceptAll",
        "title": "Accept All Pending Changes",
        "category": "AItrace",
        "icon": "$(check-all)"
      },
      {
        "command": "aitrace.pending.trace",
        "title": "Trace Change",
        "category": "AItrace",
        "icon": "$(keyboard)"
      },
      {
        "command": "aitrace.pending.discard",
        "title": "Discard Change",
        "category": "AItrace",
        "icon": "$(trash)"
      },
      {
        "command": "aitrace.pending.reveal",
        "title": "Reveal File",
        "category": "AItrace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "aitrace.pending.traceAll",
        "title": "Trace All Pending",
        "category": "AItrace",
        "icon": "$(play)"
      },
      {
        "command": "aitrace.pending.clear",
        "title": "Discard All Pending",
        "category": "AItrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "aitrace.pending.refresh",
        "title": "Refresh Pending Changes",
        "category": "AItrace",
        "icon": "$(refresh)"
      },
      {
        "command": "aitrace.enableStaging",
        "title": "Turn On AItrace",
        "category": "AItrace",
        "icon": "$(circle-outline)"
      },
      {
        "command": "aitrace.disableStaging",
        "title": "Turn Off AItrace",
        "category": "AItrace",
        "icon": "$(circle-filled)"
      },
      {
        "command": "aitrace.enter",
        "title": "AItrace: Newline"
      },
      {
        "command": "aitrace.tab",
        "title": "AItrace: Tab"
      },
      {
        "command": "aitrace.backspace",
        "title": "AItrace: Backspace"
      },
      {
        "command": "aitrace.skipLine",
        "title": "AItrace: Skip Line"
      }
    ],
    "keybindings": [
      {
        "command": "aitrace.endSession",
        "key": "escape",
        "when": "aitrace.tracing"
      },
      {
        "command": "aitrace.enter",
        "key": "enter",
        "when": "aitrace.tracing"
      },
      {
        "command": "aitrace.tab",
        "key": "tab",
        "when": "aitrace.tracing"
      },
      {
        "command": "aitrace.backspace",
        "key": "backspace",
        "when": "aitrace.tracing"
      },
      {
        "command": "aitrace.skipLine",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "aitrace.tracing"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aitrace.tour.next",
          "when": "view == aitrace.tour && aitrace.tourHasTour",
          "group": "navigation@0"
        },
        {
          "command": "aitrace.tour.refresh",
          "when": "view == aitrace.tour",
          "group": "navigation@1"
        },
        {
          "command": "aitrace.tour.reset",
          "when": "view == aitrace.tour && aitrace.tourHasTour",
          "group": "navigation@2"
        },
        {
          "command": "aitrace.enableStaging",
          "when": "view == aitrace.pending && !aitrace.stagingEnabled",
          "group": "navigation@0"
        },
        {
          "command": "aitrace.disableStaging",
          "when": "view == aitrace.pending && aitrace.stagingEnabled",
          "group": "navigation@0"
        },
        {
          "command": "aitrace.pending.acceptAll",
          "when": "view == aitrace.pending",
          "group": "navigation@1"
        },
        {
          "command": "aitrace.pending.traceAll",
          "when": "view == aitrace.pending",
          "group": "navigation@2"
        },
        {
          "command": "aitrace.pending.refresh",
          "when": "view == aitrace.pending",
          "group": "navigation@3"
        },
        {
          "command": "aitrace.pending.clear",
          "when": "view == aitrace.pending",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "aitrace.tour.reveal",
          "when": "view == aitrace.tour && viewItem == aitrace.tour.done",
          "group": "1_open"
        },
        {
          "command": "aitrace.pending.accept",
          "when": "view == aitrace.pending && viewItem == aitrace.pending",
          "group": "inline@0"
        },
        {
          "command": "aitrace.pending.trace",
          "when": "view == aitrace.pending && viewItem == aitrace.pending",
          "group": "inline@1"
        },
        {
          "command": "aitrace.pending.discard",
          "when": "view == aitrace.pending && viewItem == aitrace.pending",
          "group": "inline@2"
        },
        {
          "command": "aitrace.pending.reveal",
          "when": "view == aitrace.pending && viewItem == aitrace.pending",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "aitrace.tour.trace",
          "when": "false"
        },
        {
          "command": "aitrace.tour.reveal",
          "when": "false"
        },
        {
          "command": "aitrace.pending.trace",
          "when": "false"
        },
        {
          "command": "aitrace.pending.discard",
          "when": "false"
        },
        {
          "command": "aitrace.pending.reveal",
          "when": "false"
        },
        {
          "command": "aitrace.enter",
          "when": "false"
        },
        {
          "command": "aitrace.tab",
          "when": "false"
        },
        {
          "command": "aitrace.backspace",
          "when": "false"
        },
        {
          "command": "aitrace.skipLine",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AItrace",
      "properties": {
        "aitrace.advanceOnError": {
          "type": "boolean",
          "default": true,
          "description": "Advance the cursor even on a wrong keystroke (AItrace's non-blocking model). When false, the wrong keystroke is rejected and the ghost stays put."
        },
        "aitrace.showGhost": {
          "type": "boolean",
          "default": true,
          "description": "Render the remaining target text as dimmed ghost text in the editor."
        },
        "aitrace.playSound": {
          "type": "boolean",
          "default": false,
          "description": "Play subtle audio feedback on keystrokes (in addition to any editor keystroke sound)."
        },
        "aitrace.queueDir": {
          "type": "string",
          "default": ".aitrace",
          "description": "Workspace-relative directory the AI integrations write staged changes to."
        },
        "aitrace.debug": {
          "type": "boolean",
          "default": false,
          "description": "Log trace input handling to the 'AItrace' output channel. Useful if typing is not being scored."
        },
        "aitrace.autoTrace": {
          "type": "boolean",
          "default": false,
          "description": "Open the trace panel for each pending file automatically. When off, files wait in the AItrace sidebar until you start them."
        },
        "aitrace.run.python": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter used by Run for .py files."
        },
        "aitrace.run.node": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used by Run for .js, .mjs, and .cjs files."
        },
        "aitrace.run.tsx": {
          "type": "string",
          "default": "tsx",
          "description": "tsx executable used by Run for TypeScript files."
        },
        "aitrace.run.rustc": {
          "type": "string",
          "default": "rustc",
          "description": "Rust compiler used by Run for .rs files. Single-file compilation with rustc, not Cargo."
        },
        "aitrace.run.cpp": {
          "type": "string",
          "default": "c++",
          "description": "C++ compiler used by Run for .cpp, .cc, .cxx, and .c++ files."
        },
        "aitrace.run.rustEdition": {
          "type": "string",
          "default": "2021",
          "description": "Rust edition passed to rustc by Run."
        },
        "aitrace.run.cppStandard": {
          "type": "string",
          "default": "c++17",
          "description": "C++ standard passed to the C++ compiler by Run."
        },
        "aitrace.run.command": {
          "type": "string",
          "default": "",
          "description": "Optional command template used instead of built-in language detection. ${file} is replaced with a temporary copy of the traced source. The command runs through your shell, so only use commands you trust."
        },
        "aitrace.run.timeoutMs": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "description": "Maximum time in milliseconds for each compile or run phase."
        },
        "aitrace.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether AItrace staging is on. The AItrace sidebar toggle also controls this. Staging is active when the queue directory (.aitrace) exists."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js && node scripts/copy-plugin.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@aitrace/core": "*",
    "@aitrace/ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
