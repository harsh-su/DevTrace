{
  "name": "tether-code",
  "displayName": "Tether",
  "description": "Trace code you actually write — AI proposes, you type it. Code-aware typing practice inside the editor.",
  "version": "1.0.0",
  "private": true,
  "publisher": "byteWorxs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:tether.pending",
    "onView:tether.tour",
    "onView:tether.code"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tether",
          "title": "Tether",
          "icon": "resources/tether.svg"
        }
      ]
    },
    "views": {
      "tether": [
        {
          "id": "tether.tour",
          "name": "Learning path",
          "icon": "resources/tether.svg",
          "contextualTitle": "Tether"
        },
        {
          "id": "tether.pending",
          "name": "Pending changes",
          "icon": "resources/tether.svg",
          "contextualTitle": "Tether"
        },
        {
          "id": "tether.code",
          "name": "Code flow",
          "icon": "resources/tether.svg",
          "contextualTitle": "Tether"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tether.tour",
        "contents": "No learning path yet. Ask OpenCode to “tour me through this project” and it will order the codebase into explain-then-type steps.\n[Trace the next step](command:tether.tour.next)"
      },
      {
        "view": "tether.pending",
        "when": "!tether.stagingEnabled",
        "contents": "Tether is off. Turn it on to stage AI edits for hand-typing over ghost overlays.\n[Turn on Tether](command:tether.enableStaging)\n[Setup Google Antigravity Integration](command:tether.setupAntigravity)"
      },
      {
        "view": "tether.pending",
        "when": "tether.stagingEnabled",
        "contents": "No pending changes. When Google Antigravity proposes an edit, it will wait here for you to type it by hand.\n[Trace a selection](command:tether.traceSelection)\n[Setup Antigravity Integration](command:tether.setupAntigravity)"
      }
    ],
    "commands": [
      {
        "command": "tether.openSidebar",
        "title": "Tether: Open Sidebar (Pending Changes)"
      },
      {
        "command": "tether.setupAntigravity",
        "title": "Tether: Setup Google Antigravity Integration"
      },
      {
        "command": "tether.traceSelection",
        "title": "Tether: Trace Selection"
      },
      {
        "command": "tether.flow.open",
        "title": "Tether: Show Code Flow"
      },
      {
        "command": "tether.flow.refresh",
        "title": "Tether: Refresh Code Flow",
        "category": "Tether",
        "icon": "$(refresh)"
      },
      {
        "command": "tether.traceFile",
        "title": "Tether: Trace File Range"
      },
      {
        "command": "tether.endSession",
        "title": "Tether: End Trace Session"
      },
      {
        "command": "tether.showResults",
        "title": "Tether: Show Last Results"
      },
      {
        "command": "tether.installOpencodePlugin",
        "title": "Tether: Install OpenCode Plugin"
      },
      {
        "command": "tether.tour.trace",
        "title": "Trace Step",
        "category": "Tether",
        "icon": "$(keyboard)"
      },
      {
        "command": "tether.tour.next",
        "title": "Tether: Trace Next Learning Step",
        "category": "Tether",
        "icon": "$(play)"
      },
      {
        "command": "tether.tour.reveal",
        "title": "Reveal Step File",
        "category": "Tether",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tether.tour.reset",
        "title": "Clear Learning Path Progress",
        "category": "Tether",
        "icon": "$(clear-all)"
      },
      {
        "command": "tether.tour.refresh",
        "title": "Refresh Learning Path",
        "category": "Tether",
        "icon": "$(refresh)"
      },
      {
        "command": "tether.pending.accept",
        "title": "Accept Change (Write to Disk)",
        "category": "Tether",
        "icon": "$(check)"
      },
      {
        "command": "tether.pending.acceptAll",
        "title": "Accept All Pending Changes",
        "category": "Tether",
        "icon": "$(check-all)"
      },
      {
        "command": "tether.pending.trace",
        "title": "Trace Change",
        "category": "Tether",
        "icon": "$(keyboard)"
      },
      {
        "command": "tether.pending.discard",
        "title": "Discard Change",
        "category": "Tether",
        "icon": "$(trash)"
      },
      {
        "command": "tether.pending.reveal",
        "title": "Reveal File",
        "category": "Tether",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tether.pending.traceAll",
        "title": "Trace All Pending",
        "category": "Tether",
        "icon": "$(play)"
      },
      {
        "command": "tether.pending.clear",
        "title": "Discard All Pending",
        "category": "Tether",
        "icon": "$(clear-all)"
      },
      {
        "command": "tether.pending.refresh",
        "title": "Refresh Pending Changes",
        "category": "Tether",
        "icon": "$(refresh)"
      },
      {
        "command": "tether.enableStaging",
        "title": "Turn On Tether",
        "category": "Tether",
        "icon": "$(circle-outline)"
      },
      {
        "command": "tether.disableStaging",
        "title": "Turn Off Tether",
        "category": "Tether",
        "icon": "$(circle-filled)"
      },
      {
        "command": "tether.enter",
        "title": "Tether: Newline"
      },
      {
        "command": "tether.tab",
        "title": "Tether: Tab"
      },
      {
        "command": "tether.backspace",
        "title": "Tether: Backspace"
      },
      {
        "command": "tether.skipLine",
        "title": "Tether: Skip Line"
      }
    ],
    "keybindings": [
      {
        "command": "tether.endSession",
        "key": "escape",
        "when": "tether.tracing"
      },
      {
        "command": "tether.enter",
        "key": "enter",
        "when": "tether.tracing"
      },
      {
        "command": "tether.tab",
        "key": "tab",
        "when": "tether.tracing"
      },
      {
        "command": "tether.backspace",
        "key": "backspace",
        "when": "tether.tracing"
      },
      {
        "command": "tether.skipLine",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "tether.tracing"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tether.tour.next",
          "when": "view == tether.tour && tether.tourHasTour",
          "group": "navigation@0"
        },
        {
          "command": "tether.tour.refresh",
          "when": "view == tether.tour",
          "group": "navigation@1"
        },
        {
          "command": "tether.tour.reset",
          "when": "view == tether.tour && tether.tourHasTour",
          "group": "navigation@2"
        },
        {
          "command": "tether.enableStaging",
          "when": "view == tether.pending && !tether.stagingEnabled",
          "group": "navigation@0"
        },
        {
          "command": "tether.disableStaging",
          "when": "view == tether.pending && tether.stagingEnabled",
          "group": "navigation@0"
        },
        {
          "command": "tether.pending.acceptAll",
          "when": "view == tether.pending",
          "group": "navigation@1"
        },
        {
          "command": "tether.pending.traceAll",
          "when": "view == tether.pending",
          "group": "navigation@2"
        },
        {
          "command": "tether.pending.refresh",
          "when": "view == tether.pending",
          "group": "navigation@3"
        },
        {
          "command": "tether.pending.clear",
          "when": "view == tether.pending",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "tether.tour.reveal",
          "when": "view == tether.tour && viewItem == tether.tour.done",
          "group": "1_open"
        },
        {
          "command": "tether.pending.accept",
          "when": "view == tether.pending && viewItem == tether.pending",
          "group": "inline@0"
        },
        {
          "command": "tether.pending.trace",
          "when": "view == tether.pending && viewItem == tether.pending",
          "group": "inline@1"
        },
        {
          "command": "tether.pending.discard",
          "when": "view == tether.pending && viewItem == tether.pending",
          "group": "inline@2"
        },
        {
          "command": "tether.pending.reveal",
          "when": "view == tether.pending && viewItem == tether.pending",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "tether.tour.trace",
          "when": "false"
        },
        {
          "command": "tether.tour.reveal",
          "when": "false"
        },
        {
          "command": "tether.pending.trace",
          "when": "false"
        },
        {
          "command": "tether.pending.discard",
          "when": "false"
        },
        {
          "command": "tether.pending.reveal",
          "when": "false"
        },
        {
          "command": "tether.enter",
          "when": "false"
        },
        {
          "command": "tether.tab",
          "when": "false"
        },
        {
          "command": "tether.backspace",
          "when": "false"
        },
        {
          "command": "tether.skipLine",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Tether",
      "properties": {
        "tether.advanceOnError": {
          "type": "boolean",
          "default": true,
          "description": "Advance the cursor even on a wrong keystroke (Tether's non-blocking model). When false, the wrong keystroke is rejected and the ghost stays put."
        },
        "tether.showGhost": {
          "type": "boolean",
          "default": true,
          "description": "Render the remaining target text as dimmed ghost text in the editor."
        },
        "tether.playSound": {
          "type": "boolean",
          "default": false,
          "description": "Play subtle audio feedback on keystrokes (in addition to any editor keystroke sound)."
        },
        "tether.queueDir": {
          "type": "string",
          "default": ".tether",
          "description": "Workspace-relative directory the OpenCode plugin writes staged AI changes to."
        },
        "tether.debug": {
          "type": "boolean",
          "default": false,
          "description": "Log trace input handling to the 'Tether' output channel. Useful if typing is not being scored."
        },
        "tether.autoTrace": {
          "type": "boolean",
          "default": false,
          "description": "Open the trace panel for each pending file automatically. When off, files wait in the Tether sidebar until you start them."
        },
        "tether.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether Tether staging is on. The Tether sidebar toggle also controls this. Staging is active when the queue directory (.tether) exists."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js && node scripts/copy-plugin.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@tether/core": "*",
    "@tether/ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
