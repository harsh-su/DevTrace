{
  "name": "devtrace",
  "displayName": "DevTrace",
  "description": "Trace code you actually write — AI proposes, you type it. Code-aware typing practice inside the editor.",
  "version": "0.0.7",
  "private": true,
  "publisher": "devtrace",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:devtrace.pending",
    "onView:devtrace.tour"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devtrace",
          "title": "DevTrace",
          "icon": "resources/devtrace.svg"
        }
      ]
    },
    "views": {
      "devtrace": [
        {
          "id": "devtrace.tour",
          "name": "Learning path",
          "icon": "resources/devtrace.svg",
          "contextualTitle": "DevTrace"
        },
        {
          "id": "devtrace.pending",
          "name": "Pending changes",
          "icon": "resources/devtrace.svg",
          "contextualTitle": "DevTrace"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "devtrace.tour",
        "contents": "No learning path yet. Ask OpenCode to “tour me through this project” and it will order the codebase into explain-then-type steps.\n[Trace the next step](command:devtrace.tour.next)"
      },
      {
        "view": "devtrace.pending",
        "when": "!devtrace.stagingEnabled",
        "contents": "DevTrace is off. Turn it on to stage AI edits for hand-typing over ghost overlays.\n[Turn on DevTrace](command:devtrace.enableStaging)\n[Setup Google Antigravity Integration](command:devtrace.setupAntigravity)"
      },
      {
        "view": "devtrace.pending",
        "when": "devtrace.stagingEnabled",
        "contents": "No pending changes. When Google Antigravity proposes an edit, it will wait here for you to type it by hand.\n[Trace a selection](command:devtrace.traceSelection)\n[Setup Antigravity Integration](command:devtrace.setupAntigravity)"
      }
    ],
    "commands": [
      {
        "command": "devtrace.openSidebar",
        "title": "DevTrace: Open Sidebar (Pending Changes)"
      },
      {
        "command": "devtrace.setupAntigravity",
        "title": "DevTrace: Setup Google Antigravity Integration"
      },
      {
        "command": "devtrace.traceSelection",
        "title": "DevTrace: Trace Selection"
      },
      {
        "command": "devtrace.traceFile",
        "title": "DevTrace: Trace File Range"
      },
      {
        "command": "devtrace.endSession",
        "title": "DevTrace: End Trace Session"
      },
      {
        "command": "devtrace.showResults",
        "title": "DevTrace: Show Last Results"
      },
      {
        "command": "devtrace.installOpencodePlugin",
        "title": "DevTrace: Install OpenCode Plugin"
      },
      {
        "command": "devtrace.tour.trace",
        "title": "Trace Step",
        "category": "DevTrace",
        "icon": "$(keyboard)"
      },
      {
        "command": "devtrace.tour.next",
        "title": "DevTrace: Trace Next Learning Step",
        "category": "DevTrace",
        "icon": "$(play)"
      },
      {
        "command": "devtrace.tour.reveal",
        "title": "Reveal Step File",
        "category": "DevTrace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devtrace.tour.reset",
        "title": "Clear Learning Path Progress",
        "category": "DevTrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "devtrace.tour.refresh",
        "title": "Refresh Learning Path",
        "category": "DevTrace",
        "icon": "$(refresh)"
      },
      {
        "command": "devtrace.pending.accept",
        "title": "Accept Change (Write to Disk)",
        "category": "DevTrace",
        "icon": "$(check)"
      },
      {
        "command": "devtrace.pending.acceptAll",
        "title": "Accept All Pending Changes",
        "category": "DevTrace",
        "icon": "$(check-all)"
      },
      {
        "command": "devtrace.pending.trace",
        "title": "Trace Change",
        "category": "DevTrace",
        "icon": "$(keyboard)"
      },
      {
        "command": "devtrace.pending.discard",
        "title": "Discard Change",
        "category": "DevTrace",
        "icon": "$(trash)"
      },
      {
        "command": "devtrace.pending.reveal",
        "title": "Reveal File",
        "category": "DevTrace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "devtrace.pending.traceAll",
        "title": "Trace All Pending",
        "category": "DevTrace",
        "icon": "$(play)"
      },
      {
        "command": "devtrace.pending.clear",
        "title": "Discard All Pending",
        "category": "DevTrace",
        "icon": "$(clear-all)"
      },
      {
        "command": "devtrace.pending.refresh",
        "title": "Refresh Pending Changes",
        "category": "DevTrace",
        "icon": "$(refresh)"
      },
      {
        "command": "devtrace.enableStaging",
        "title": "Turn On DevTrace",
        "category": "DevTrace",
        "icon": "$(circle-outline)"
      },
      {
        "command": "devtrace.disableStaging",
        "title": "Turn Off DevTrace",
        "category": "DevTrace",
        "icon": "$(circle-filled)"
      },
      {
        "command": "devtrace.enter",
        "title": "DevTrace: Newline"
      },
      {
        "command": "devtrace.tab",
        "title": "DevTrace: Tab"
      },
      {
        "command": "devtrace.backspace",
        "title": "DevTrace: Backspace"
      },
      {
        "command": "devtrace.skipLine",
        "title": "DevTrace: Skip Line"
      }
    ],
    "keybindings": [
      {
        "command": "devtrace.endSession",
        "key": "escape",
        "when": "devtrace.tracing"
      },
      {
        "command": "devtrace.enter",
        "key": "enter",
        "when": "devtrace.tracing"
      },
      {
        "command": "devtrace.tab",
        "key": "tab",
        "when": "devtrace.tracing"
      },
      {
        "command": "devtrace.backspace",
        "key": "backspace",
        "when": "devtrace.tracing"
      },
      {
        "command": "devtrace.skipLine",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "devtrace.tracing"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devtrace.tour.next",
          "when": "view == devtrace.tour && devtrace.tourHasTour",
          "group": "navigation@0"
        },
        {
          "command": "devtrace.tour.refresh",
          "when": "view == devtrace.tour",
          "group": "navigation@1"
        },
        {
          "command": "devtrace.tour.reset",
          "when": "view == devtrace.tour && devtrace.tourHasTour",
          "group": "navigation@2"
        },
        {
          "command": "devtrace.enableStaging",
          "when": "view == devtrace.pending && !devtrace.stagingEnabled",
          "group": "navigation@0"
        },
        {
          "command": "devtrace.disableStaging",
          "when": "view == devtrace.pending && devtrace.stagingEnabled",
          "group": "navigation@0"
        },
        {
          "command": "devtrace.pending.acceptAll",
          "when": "view == devtrace.pending",
          "group": "navigation@1"
        },
        {
          "command": "devtrace.pending.traceAll",
          "when": "view == devtrace.pending",
          "group": "navigation@2"
        },
        {
          "command": "devtrace.pending.refresh",
          "when": "view == devtrace.pending",
          "group": "navigation@3"
        },
        {
          "command": "devtrace.pending.clear",
          "when": "view == devtrace.pending",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "devtrace.tour.reveal",
          "when": "view == devtrace.tour && viewItem == devtrace.tour.done",
          "group": "1_open"
        },
        {
          "command": "devtrace.pending.accept",
          "when": "view == devtrace.pending && viewItem == devtrace.pending",
          "group": "inline@0"
        },
        {
          "command": "devtrace.pending.trace",
          "when": "view == devtrace.pending && viewItem == devtrace.pending",
          "group": "inline@1"
        },
        {
          "command": "devtrace.pending.discard",
          "when": "view == devtrace.pending && viewItem == devtrace.pending",
          "group": "inline@2"
        },
        {
          "command": "devtrace.pending.reveal",
          "when": "view == devtrace.pending && viewItem == devtrace.pending",
          "group": "1_open"
        }
      ],
      "commandPalette": [
        {
          "command": "devtrace.tour.trace",
          "when": "false"
        },
        {
          "command": "devtrace.tour.reveal",
          "when": "false"
        },
        {
          "command": "devtrace.pending.trace",
          "when": "false"
        },
        {
          "command": "devtrace.pending.discard",
          "when": "false"
        },
        {
          "command": "devtrace.pending.reveal",
          "when": "false"
        },
        {
          "command": "devtrace.enter",
          "when": "false"
        },
        {
          "command": "devtrace.tab",
          "when": "false"
        },
        {
          "command": "devtrace.backspace",
          "when": "false"
        },
        {
          "command": "devtrace.skipLine",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "DevTrace",
      "properties": {
        "devtrace.advanceOnError": {
          "type": "boolean",
          "default": true,
          "description": "Advance the cursor even on a wrong keystroke (DevTrace's non-blocking model). When false, the wrong keystroke is rejected and the ghost stays put."
        },
        "devtrace.showGhost": {
          "type": "boolean",
          "default": true,
          "description": "Render the remaining target text as dimmed ghost text in the editor."
        },
        "devtrace.playSound": {
          "type": "boolean",
          "default": false,
          "description": "Play subtle audio feedback on keystrokes (in addition to any editor keystroke sound)."
        },
        "devtrace.queueDir": {
          "type": "string",
          "default": ".devtrace",
          "description": "Workspace-relative directory the OpenCode plugin writes staged AI changes to."
        },
        "devtrace.debug": {
          "type": "boolean",
          "default": false,
          "description": "Log trace input handling to the 'DevTrace' output channel. Useful if typing is not being scored."
        },
        "devtrace.autoTrace": {
          "type": "boolean",
          "default": false,
          "description": "Open the trace panel for each staged AI change automatically. When off, changes wait in the DevTrace sidebar until you start them."
        },
        "devtrace.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether DevTrace staging is on. The DevTrace sidebar toggle also controls this. Staging is active when the queue directory (.devtrace) exists."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js && node scripts/copy-plugin.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@devtrace/core": "*",
    "@devtrace/ui": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
