{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AItrace Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/vscode"],
      "outFiles": ["${workspaceFolder}/vscode/dist/**/*.js"],
      "preLaunchTask": "aitrace: build extension"
    }
  ]
}
